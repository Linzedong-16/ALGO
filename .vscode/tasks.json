{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc.exe 生成活动文件",
            "command": "cmd",
            "args": [
                "/c",
                "gcc -std=c11 -Wall -Wextra -g -fexec-charset=UTF-8 \"${file}\" -o \"${workspaceFolder}\\${fileBasenameNoExtension}.exe\" && \"${workspaceFolder}\\${fileBasenameNoExtension}.exe\" & del \"${workspaceFolder}\\${fileBasenameNoExtension}.exe\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}